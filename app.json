{
  "expo": {
    "name": "AKNA Transport",
    "slug": "AknaTransportNative",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aknatransport",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kabul ettiğiniz nakliye işi sürerken aracınızın konumunu yöneticinizle paylaşmak için konum izni gerekir.",
          "locationAlwaysAndWhenInUsePermission": "Kabul ettiğiniz nakliye işi sürerken uygulama arka plandayken de aracınızın konumu paylaşılır. Takip yalnızca aktif iş süresince çalışır ve iş tamamlanınca veya iptal edilince durur.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#000000"
  }
}
